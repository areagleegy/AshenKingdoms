  "title": {
    "en": "Ashen Kingdoms",
    "ar": "ممالك الرماد"
  },
  "lore": {
    "era": "The Afterfall",
    "premise": "The Crown of Embers shattered, leaving seven regions connected by old roads, flooded tunnels and dangerous sea lanes. Ash storms distort magic and awaken ancient guardians.",
    "central_mystery": "The ashfall is not merely volcanic. The buried Bell Engine beneath the old capital is still ringing, and each ring changes one part of the world."
  },
  "world_rules": {
    "magic_source": "Emberglass, crystallized residue of the shattered Crown",
    "magic_cost": "Heat, stamina and sometimes a temporary loss of memory",
    "travel_scale": "Regional travel is represented by connected gameplay zones; distances are design estimates, not a real-world map scale.",
    "server_authority": [
      "damage",
      "loot",
      "quest completion",
      "currency",
      "inventory mutations",
      "boss state"
    ],
    "content_status": "Design data only; not yet wired to runtime scenes or gameplay systems."
  },
